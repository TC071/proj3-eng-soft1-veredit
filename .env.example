# ==========================================
# Configurações do Ambiente — Veridit
# ==========================================

# Banco de Dados (PostgreSQL - ADR 4)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=veridit
POSTGRES_USER=veridit_user
POSTGRES_PASSWORD=veridit_secret

# Autenticação e Segurança (ADR 2, ADR 5)
JWT_SECRET=super_secret_jwt_key_veridit_2026_change_in_production
JWT_EXPIRES_IN=15m

# Serviço de Identidade
IDENTITY_PORT=8001
IDENTITY_SERVICE_URL=http://localhost:8001

# Serviço de Registros & Captura
RECORDS_PORT=8002
RECORDS_SERVICE_URL=http://localhost:8002

# Frontend (Portal Web SPA - ADR 6)
FRONTEND_PORT=3000

# Armazenamento de Evidências (ADR 7)
EVIDENCE_STORAGE_PATH=./evidence_storage

